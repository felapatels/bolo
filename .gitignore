# Replit
.cache/
.local/

# QA E2E screenshots
qa/shots/

# Pronunciation pilot — WAV clip files (large; stay in /tmp)
qa/pilot-clips/

# Production voice-audit clips pulled from tts_cache (binary audio; never committed)
qa/tts-audit-prod-gu-clips/

# Pilot corpus manifest + raw calibration results (reference R2 keys; recordings never enter the repo)
qa/pilot-results/manifest.json
qa/pilot-results/calibration/

# Owner ruling (August 4, 2026): keep platform publish commits from sweeping these in
attached_assets/
.agents/

# Noise robustness bench raw runs (learner transcripts; sample.json + summary.md are committed)
qa/pilot-results/noise-bench/results.jsonl

# Downloaded production audio clips (task 1047 dry run) — regenerable from the prod cache; never commit
qa/tts-audit-prod-gu-clips/

# Local secrets. Replit ignored these via a machine file that does not
# exist outside it, so the rule has to live in the repo. The glob is
# deliberately wide: .env.bak and .env.save slip past an explicit list, and a
# leaked key costs more than an ignored file nobody wanted ignored.
.env*
# Templates carry no secrets and must stay committed. Covers the root and
# artifacts/bolo-mobile/.env.production.example alike.
!.env*.example
