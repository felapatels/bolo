{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // dom.iterable, added 2026-09-07. orval from 8.22 emits
    // `Object.fromEntries(h.entries())` in its header handling, and
    // `Headers.entries()` is declared in lib.dom.iterable rather than in
    // lib.dom, so a regenerated client fails to compile with TS2339 without
    // this line.
    //
    // WHETHER IT CHANGES ANYTHING IN *THIS* REPO DEPENDS ON *THIS* REPO'S
    // RESOLVED ORVAL, WHICH IS THE LOCKFILE'S ANSWER AND NOT package.json'S.
    // Check before assuming, in either direction:
    //   grep orval lib/api-spec/package.json
    //   ls node_modules/.pnpm | grep '^orval@'
    //   head -3 lib/api-client-react/src/generated/api.ts   # the banner
    //   grep -c fromEntries lib/api-client-react/src/generated/api.ts
    // A declared range, a resolved version and the version that produced the
    // committed output are three different facts and have been seen to
    // disagree across the forks. This line costs nothing where the call is not
    // emitted and prevents an outage where it is.
    "lib": ["dom", "dom.iterable", "es2022"]
  },
  "include": ["src"]
}
