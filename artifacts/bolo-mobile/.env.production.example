# Production build-time configuration for Bolo! Mobile.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.
# In development the `dev` script (package.json) sets them from the Replit
# environment; for a release build you must provide production values instead.
#
# Recommended: store these as EAS environment variables so cloud builds pick
# them up automatically (values are then NOT needed in any local file):
#
#   eas env:create --environment production --name EXPO_PUBLIC_DOMAIN --value <your-domain>
#   eas env:create --environment production --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_live_...
#
# Alternative: copy this file to `.env.production` (git-ignored) and run
# `eas build --platform ios --profile production`, Expo CLI loads it.

# Host of the deployed backend + web app (NO protocol). The app calls
# https://<domain>/api/... and links to https://<domain>/privacy etc.
EXPO_PUBLIC_DOMAIN=your-deployed-domain.replit.app

# Clerk PRODUCTION publishable key (pk_live_...). The dev key (pk_test_...)
# will not work for real users and shows a "development keys" warning.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxx

# Sentry error reporting (optional but strongly recommended for production, crashes are invisible without it). DSN from your Sentry project settings.
# Omit entirely to disable; init is a no-op without it.
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# Source map upload during EAS builds additionally needs SENTRY_AUTH_TOKEN as
# an EAS secret and real org/project slugs in app.json's @sentry/react-native
# plugin entry.

# PostHog product analytics. Project API key (phc_...). Omit to disable.
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
# Only set if not on PostHog US cloud:
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
