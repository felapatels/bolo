{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node ../../scripts/check-conflict-markers.mjs && pnpm --filter @workspace/db run sync-schema && node --import tsx ./scripts/runTestsLocked.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-lessons": "node --import tsx ./scripts/generateCuratedLessons.ts",
    "generate-sentences-c1": "node --import tsx ./scripts/generateSentenceTopupsC1.ts",
    "qa-sentences-c1": "node --import tsx ./scripts/qaSentencesC1.ts",
    "generate-sentences-rollout": "node --import tsx ./scripts/generateSentenceTopupsRollout.ts",
    "qa-sentences-rollout": "node --import tsx ./scripts/qaSentencesRollout.ts",
    "prune-rollout-majors": "node --import tsx ./scripts/pruneRolloutMajors.ts",
    "seed-stripe-products": "node --import tsx ./scripts/seedStripeProducts.ts",
    "purge-stale-tts-cache": "node --import tsx ./scripts/purgeStaleAudioCache.ts",
    "prewarm-full-tts-cache": "node --import tsx ./scripts/prewarmFullTtsCache.ts",
    "audit-tts-cache": "node \"$(ls ../../node_modules/.pnpm/tsx@*/node_modules/tsx/dist/cli.mjs | head -1)\" scripts/auditTtsCache.ts",
    "test:pure": "node --import tsx --test --experimental-test-module-mocks $(cat pure-tests.txt)"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@clerk/express": "^2.1.40",
    "@clerk/shared": "^4.25.2",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@replit/connectors-sdk": "^0.4.1",
    "@sentry/node": "^10.68.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/daily-gift": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/script-trace": "workspace:*",
    "@workspace/story": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.16",
    "nodemailer": "^9.0.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "ts-fsrs": "^5.4.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.23.0"
  }
}
