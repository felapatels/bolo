{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm --filter @workspace/db run sync-schema && node --import tsx ./scripts/runTestsLocked.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-lessons": "node --import tsx ./scripts/generateCuratedLessons.ts",
    "seed-stripe-products": "node --import tsx ./scripts/seedStripeProducts.ts",
    "purge-stale-tts-cache": "node --import tsx ./scripts/purgeStaleAudioCache.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.40",
    "@clerk/shared": "^4.25.2",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "4.23.0"
  }
}
